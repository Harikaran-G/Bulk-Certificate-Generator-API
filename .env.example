# Backend Configuration
APP_NAME="Bulk Certificate Generator API"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-secret-in-production-key-2026
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
